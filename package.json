    "@angular/router": "^22.1.0",
    "@lucide/angular": "^1.42.0",
    "firebase": "^12.18.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
