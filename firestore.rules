rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isTeacher() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    // users/{uid}: perfil de acceso. El registro es SOLO por invitación: el
    // alta se crea recién al canjear una invitación (ver invitations/{code}
    // más abajo), nunca libremente. Un usuario nunca puede auto-asignarse
    // "admin"/"teacher" ni tocar su propio status; solo un admin puede
    // cambiar status/role de OTRO usuario.
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin() || isTeacher());

      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.status == 'approved'
        && request.resource.data.role in ['student', 'teacher']
        && request.resource.data.invitationCode is string
        && get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationCode)).data.usedByUid == request.auth.uid
        && get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationCode)).data.role == request.resource.data.role
        && request.resource.data.enrolledSubjectIds == get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationCode)).data.subjectIds;

      allow update: if request.auth != null && isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'role', 'enrolledSubjectIds', 'updatedAt']);

      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['locale', 'updatedAt']);

      allow delete: if false;
    }

    // invitations/{code}: el código es el propio id del doc. Un profesor
    // solo puede invitar con rol "student"; el admin puede invitar
    // "student" o "teacher".
    match /invitations/{code} {
      // Leer una invitación puntual: staff, quien ya la canjeó, o el dueño
      // del email al que fue dirigida (necesario para poder canjearla).
      // Que cualquier autenticado pudiera leer cualquier código habilitaba
      // adivinar/enumerar invitaciones ajenas.
      allow get: if request.auth != null
        && (isAdmin() || isTeacher()
            || resource.data.usedByUid == request.auth.uid
            || request.auth.token.email.lower() == resource.data.email);
      allow list: if request.auth != null && (isAdmin() || isTeacher());

      allow create: if request.auth != null
        && request.resource.data.status == 'pending'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.subjectIds is list
        && ((isAdmin() && request.resource.data.role in ['student', 'teacher'])
            || (isTeacher() && request.resource.data.role == 'student'));

      // Canjear: solo el dueño del email al que se dirigió la invitación
      // puede marcarse a sí mismo como quien la usó. Sin este chequeo, el
      // código funcionaba como un bearer token: cualquiera que lo
      // consiguiera (link reenviado, filtrado, adivinado) podía canjearlo
      // con su propia cuenta y quedarse con el rol/materias de otra
      // persona.
      allow update: if request.auth != null
        && resource.data.status == 'pending'
        && request.resource.data.status == 'used'
        && request.resource.data.usedByUid == request.auth.uid
        && request.auth.token.email.lower() == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'usedByUid', 'usedAt']);

      // Revocar: quien la creó, o un admin.
      allow update: if request.auth != null && (isAdmin() || resource.data.createdBy == request.auth.uid)
        && resource.data.status == 'pending'
        && request.resource.data.status == 'revoked'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

      // Corregir el email (ej. typo) antes de que se canjee: quien la creó, o un admin.
      allow update: if request.auth != null && (isAdmin() || resource.data.createdBy == request.auth.uid)
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email']);

      // Borrar del historial: quien la creó, o un admin (cualquier estado).
      allow delete: if request.auth != null && (isAdmin() || resource.data.createdBy == request.auth.uid);
    }

    // subjects/{id}: catálogo de materias. Solo el admin crea/edita/borra;
    // cualquier autenticado puede leer (get o list, sin datos sensibles acá)
    // — necesario para que un estudiante resuelva sus propias materias vía
    // una query "documentId() in [...]", que Firestore evalúa como "list",
    // no como varios "get" sueltos.
    match /subjects/{subjectId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // subjectAssignments/{id}: une una materia con uno de sus profesores
    // (una materia puede tener varios). Mismo motivo de lectura abierta que
    // subjects — sin datos sensibles, y necesario para que un estudiante
    // resuelva los profesores de sus materias vía "subjectId in [...]"
    // (list, no varios get). El admin y cualquier profesor agregan/quitan
    // asignaciones — esta colección es tabla derivada de
    // courseSubjectTeachers (ver CourseSubjectTeachersService), que un
    // profesor ya puede escribir desde Cursos, así que necesita el mismo
    // permiso acá para que ese flujo no falle. No hay "update" — para
    // corregir una, se borra y se crea de nuevo.
    match /subjectAssignments/{assignmentId} {
      allow read: if request.auth != null;
      // El id debe coincidir con los datos (materiaId_profesorId): es lo
      // que permite que gradeCategories/grades verifiquen la asignación
      // real con un exists() por path conocido, más abajo.
      allow create: if (isAdmin() || isTeacher())
        && assignmentId == request.resource.data.subjectId + '_' + request.resource.data.teacherId;
      allow delete: if isAdmin() || isTeacher();
    }

    // gradeCategories/{id}: la rúbrica de una materia (categorías con
    // peso, ej. "Asistencia" 10%). El admin, o el profesor realmente
    // asignado a esa materia (ver subjectAssignments), puede definirla;
    // cualquier autenticado puede leerla (el estudiante necesita ver los
    // nombres/pesos junto a sus notas). Que la suma de pesos dé 100 no se
    // puede validar acá (no hay agregación entre docs sin Cloud
    // Functions) — se valida en el cliente.
    match /gradeCategories/{categoryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && (isAdmin() || exists(/databases/$(database)/documents/subjectAssignments/$(request.resource.data.subjectId + '_' + request.auth.uid)));
      allow update, delete: if request.auth != null
        && (isAdmin() || exists(/databases/$(database)/documents/subjectAssignments/$(resource.data.subjectId + '_' + request.auth.uid)));
    }

    // assignments/{id}: una tarea individual dentro de una categoría (ej.
    // "Tarea 1" dentro de "Tareas"). Mismo criterio de permisos que
    // gradeCategories.
    match /assignments/{assignmentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && (isAdmin() || exists(/databases/$(database)/documents/subjectAssignments/$(request.resource.data.subjectId + '_' + request.auth.uid)));
      allow update, delete: if request.auth != null
        && (isAdmin() || exists(/databases/$(database)/documents/subjectAssignments/$(resource.data.subjectId + '_' + request.auth.uid)));
    }

    // grades/{subjectId_studentUid}: la nota de un estudiante en una
    // materia, id determinístico (mismo motivo que subjectAssignments).
    // Lectura: el propio estudiante o cualquier staff. Escritura: estricta
    // — solo admin o el profesor asignado a ESA materia, y solo si el
    // estudiante está realmente inscripto en ella.
    match /grades/{gradeId} {
      // El id ES subjectId_studentUid: alcanza con verificar que el uid
      // coincida con el final del id (no se puede leer `resource.data`
      // para saber de quién es la nota si el documento todavía no existe
      // — un estudiante sin notas cargadas necesita poder consultar "¿ya
      // tengo nota?" y recibir "no existe" en vez de permission-denied).
      allow get: if request.auth != null
        && (isAdmin() || isTeacher() || gradeId.matches('.*_' + request.auth.uid));
      allow list: if request.auth != null && (isAdmin() || isTeacher());

      allow create, update: if request.auth != null
        && gradeId == request.resource.data.subjectId + '_' + request.resource.data.studentUid
        && (isAdmin() || exists(/databases/$(database)/documents/subjectAssignments/$(request.resource.data.subjectId + '_' + request.auth.uid)));

      allow delete: if isAdmin();
    }

    // courses/{id}: agrupa estudiantes por énfasis/año (ver
    // courses.model.ts) — reemplaza la asignación manual de materias. El
    // admin y cualquier profesor administran cursos; cualquier
    // autenticado puede leer.
    match /courses/{courseId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin() || isTeacher();
    }

    // courseSubjects/{courseId_subjectId}: qué materias tiene un curso
    // (una materia puede estar en varios cursos). Mismo patrón de id
    // determinístico que subjectAssignments.
    match /courseSubjects/{id} {
      allow read: if request.auth != null;
      allow create: if (isAdmin() || isTeacher())
        && id == request.resource.data.courseId + '_' + request.resource.data.subjectId;
      allow delete: if isAdmin() || isTeacher();
    }

    // courseStudents/{courseId_studentUid}: qué estudiantes tiene un curso
    // (un estudiante puede estar en varios cursos el mismo año).
    match /courseStudents/{id} {
      allow read: if request.auth != null;
      allow create: if (isAdmin() || isTeacher())
        && id == request.resource.data.courseId + '_' + request.resource.data.studentUid;
      allow delete: if isAdmin() || isTeacher();
    }

    // courseTeachers/{courseId_teacherId}: qué profesores participan de un
    // curso (paso 1, antes de decidir quién dicta cada materia).
    match /courseTeachers/{id} {
      allow read: if request.auth != null;
      allow create: if (isAdmin() || isTeacher())
        && id == request.resource.data.courseId + '_' + request.resource.data.teacherId;
      allow delete: if isAdmin() || isTeacher();
    }

    // courseSubjectTeachers/{courseId_subjectId}: de los profesores ya
    // asignados al curso, cuál dicta cada materia (paso 2) — a lo sumo
    // uno por materia dentro del curso, por eso el id no incluye el
    // teacherId: asignar otro profesor hace update sobre la misma fila.
    // El cliente (CourseSubjectTeachersService) mantiene subjectAssignments
    // como derivado de esto — esa colección y sus reglas no cambian.
    match /courseSubjectTeachers/{id} {
      allow read: if request.auth != null;
      allow create: if (isAdmin() || isTeacher())
        && id == request.resource.data.courseId + '_' + request.resource.data.subjectId;
      allow update: if (isAdmin() || isTeacher())
        && id == request.resource.data.courseId + '_' + request.resource.data.subjectId;
      allow delete: if isAdmin() || isTeacher();
    }

    // Deny-all por defecto para cualquier otra colección.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
