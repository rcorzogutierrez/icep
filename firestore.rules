rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isTeacher() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    // users/{uid}: perfil de acceso. El registro es SOLO por invitación: el
    // alta se crea recién al canjear una invitación (ver invitations/{code}
    // más abajo), nunca libremente. Un usuario nunca puede auto-asignarse
    // "admin"/"teacher" ni tocar su propio status; solo un admin puede
    // cambiar status/role de OTRO usuario.
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin() || isTeacher());

      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.status == 'approved'
        && request.resource.data.role in ['student', 'teacher']
        && request.resource.data.invitationCode is string
        && get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationCode)).data.usedByUid == request.auth.uid
        && get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationCode)).data.role == request.resource.data.role
        && request.resource.data.enrolledSubjectIds == get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationCode)).data.subjectIds;

      allow update: if request.auth != null && isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'role', 'enrolledSubjectIds', 'updatedAt']);

      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['locale', 'updatedAt']);

      allow delete: if false;
    }

    // invitations/{code}: el código es el propio id del doc. Un profesor
    // solo puede invitar con rol "student"; el admin puede invitar
    // "student" o "teacher".
    match /invitations/{code} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && (isAdmin() || isTeacher());

      allow create: if request.auth != null
        && request.resource.data.status == 'pending'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.subjectIds is list
        && ((isAdmin() && request.resource.data.role in ['student', 'teacher'])
            || (isTeacher() && request.resource.data.role == 'student'));

      // Canjear: cualquier autenticado se marca a sí mismo como quien la usó.
      allow update: if request.auth != null
        && resource.data.status == 'pending'
        && request.resource.data.status == 'used'
        && request.resource.data.usedByUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'usedByUid', 'usedAt']);

      // Revocar: quien la creó, o un admin.
      allow update: if request.auth != null && (isAdmin() || resource.data.createdBy == request.auth.uid)
        && resource.data.status == 'pending'
        && request.resource.data.status == 'revoked'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

      // Corregir el email (ej. typo) antes de que se canjee: quien la creó, o un admin.
      allow update: if request.auth != null && (isAdmin() || resource.data.createdBy == request.auth.uid)
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email']);

      // Borrar del historial: quien la creó, o un admin (cualquier estado).
      allow delete: if request.auth != null && (isAdmin() || resource.data.createdBy == request.auth.uid);
    }

    // subjects/{id}: catálogo de materias. Solo el admin crea/edita/borra;
    // cualquier autenticado puede leer (get o list, sin datos sensibles acá)
    // — necesario para que un estudiante resuelva sus propias materias vía
    // una query "documentId() in [...]", que Firestore evalúa como "list",
    // no como varios "get" sueltos.
    match /subjects/{subjectId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // subjectAssignments/{id}: une una materia con uno de sus profesores
    // (una materia puede tener varios). Mismo motivo de lectura abierta que
    // subjects — sin datos sensibles, y necesario para que un estudiante
    // resuelva los profesores de sus materias vía "subjectId in [...]"
    // (list, no varios get). Solo el admin agrega/quita asignaciones; no
    // hay "update" — para corregir una, se borra y se crea de nuevo.
    match /subjectAssignments/{assignmentId} {
      allow read: if request.auth != null;
      // El id debe coincidir con los datos (materiaId_profesorId): es lo
      // que permite que gradeCategories/grades verifiquen la asignación
      // real con un exists() por path conocido, más abajo.
      allow create: if isAdmin()
        && assignmentId == request.resource.data.subjectId + '_' + request.resource.data.teacherId;
      allow delete: if isAdmin();
    }

    // gradeCategories/{id}: la rúbrica de una materia (categorías con
    // peso, ej. "Asistencia" 10%). El admin, o el profesor realmente
    // asignado a esa materia (ver subjectAssignments), puede definirla;
    // cualquier autenticado puede leerla (el estudiante necesita ver los
    // nombres/pesos junto a sus notas). Que la suma de pesos dé 100 no se
    // puede validar acá (no hay agregación entre docs sin Cloud
    // Functions) — se valida en el cliente.
    match /gradeCategories/{categoryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && (isAdmin() || exists(/databases/$(database)/documents/subjectAssignments/$(request.resource.data.subjectId + '_' + request.auth.uid)));
      allow update, delete: if request.auth != null
        && (isAdmin() || exists(/databases/$(database)/documents/subjectAssignments/$(resource.data.subjectId + '_' + request.auth.uid)));
    }

    // assignments/{id}: una tarea individual dentro de una categoría (ej.
    // "Tarea 1" dentro de "Tareas"). Mismo criterio de permisos que
    // gradeCategories.
    match /assignments/{assignmentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && (isAdmin() || exists(/databases/$(database)/documents/subjectAssignments/$(request.resource.data.subjectId + '_' + request.auth.uid)));
      allow update, delete: if request.auth != null
        && (isAdmin() || exists(/databases/$(database)/documents/subjectAssignments/$(resource.data.subjectId + '_' + request.auth.uid)));
    }

    // grades/{subjectId_studentUid}: la nota de un estudiante en una
    // materia, id determinístico (mismo motivo que subjectAssignments).
    // Lectura: el propio estudiante o cualquier staff. Escritura: estricta
    // — solo admin o el profesor asignado a ESA materia, y solo si el
    // estudiante está realmente inscripto en ella.
    match /grades/{gradeId} {
      allow get: if request.auth != null
        && (isAdmin() || isTeacher() || resource.data.studentUid == request.auth.uid);
      allow list: if request.auth != null && (isAdmin() || isTeacher());

      allow create, update: if request.auth != null
        && gradeId == request.resource.data.subjectId + '_' + request.resource.data.studentUid
        && (isAdmin() || exists(/databases/$(database)/documents/subjectAssignments/$(request.resource.data.subjectId + '_' + request.auth.uid)))
        && request.resource.data.subjectId in get(/databases/$(database)/documents/users/$(request.resource.data.studentUid)).data.enrolledSubjectIds;

      allow delete: if isAdmin();
    }

    // Deny-all por defecto para cualquier otra colección.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
